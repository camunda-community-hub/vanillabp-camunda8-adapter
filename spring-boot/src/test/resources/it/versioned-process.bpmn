<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_Versioned"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="VersionedProcess" isExecutable="true">
    <bpmn:startEvent id="VP_Start">
      <bpmn:outgoing>VP_ToTask</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="VP_ToTask" sourceRef="VP_Start" targetRef="VP_Task" />
    <bpmn:serviceTask id="VP_Task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="versionedTask" />
      </bpmn:extensionElements>
      <bpmn:incoming>VP_ToTask</bpmn:incoming>
      <bpmn:outgoing>VP_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="VP_ToEnd" sourceRef="VP_Task" targetRef="VP_End" />
    <bpmn:endEvent id="VP_End">
      <bpmn:incoming>VP_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
