<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_multi_instance" targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    What the adapter has to report about an iteration. Sequential on purpose -
    the values a job carries are the same either way, and a sequential order makes the
    assertion an exact string rather than a set.
  -->
  <bpmn:process id="MultiInstanceProcess" isExecutable="true">
    <bpmn:startEvent id="MI_Start">
      <bpmn:outgoing>MI_ToFlat</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="MI_ToFlat" sourceRef="MI_Start" targetRef="MI_FlatTask" />
    <bpmn:serviceTask id="MI_FlatTask">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="collectPerItem" />
      </bpmn:extensionElements>
      <bpmn:incoming>MI_ToFlat</bpmn:incoming>
      <bpmn:outgoing>MI_ToSub</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&#34;a&#34;,&#34;b&#34;]" inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="MI_ToSub" sourceRef="MI_FlatTask" targetRef="MI_OuterSub" />
    <!-- a multi-instance task inside a multi-instance subprocess: two iterations at once -->
    <bpmn:subProcess id="MI_OuterSub">
      <bpmn:incoming>MI_ToSub</bpmn:incoming>
      <bpmn:outgoing>MI_ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&#34;g1&#34;,&#34;g2&#34;]" inputElement="group" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="MI_SubStart">
        <bpmn:outgoing>MI_SubToTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="MI_SubToTask" sourceRef="MI_SubStart" targetRef="MI_NestedTask" />
      <bpmn:serviceTask id="MI_NestedTask">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="collectNested" />
        </bpmn:extensionElements>
        <bpmn:incoming>MI_SubToTask</bpmn:incoming>
        <bpmn:outgoing>MI_TaskToSubEnd</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=[&#34;x&#34;,&#34;y&#34;,&#34;z&#34;]" inputElement="item" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="MI_TaskToSubEnd" sourceRef="MI_NestedTask" targetRef="MI_SubEnd" />
      <bpmn:endEvent id="MI_SubEnd">
        <bpmn:incoming>MI_TaskToSubEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="MI_ToEnd" sourceRef="MI_OuterSub" targetRef="MI_End" />
    <bpmn:endEvent id="MI_End">
      <bpmn:incoming>MI_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
