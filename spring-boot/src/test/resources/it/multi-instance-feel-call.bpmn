<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_multi_instance_feel_call" targetNamespace="http://bpmn.io/schema/bpmn">
  <!--
    The caller of the test about a called process named by an expression. Three
    multi-instance subprocesses in a row, each with a call activity which names the process
    it calls by '=whichProcess' rather than statically, so no deployment can resolve it. Each
    call tells the called process which of the three cases it is, because a case which loses
    the chain cannot be told apart by what it reports.

    The second and the third subprocess write 'vanillabpMiParents' themselves, which nothing
    stops an application from doing: a text makes append() return null and the chain is lost
    without an incident, a list of texts is appended to and the reader has to leave those
    entries out. Sequential on purpose, so the assertion is an exact string.
  -->
  <bpmn:process id="MiFeelCallProcess" isExecutable="true">
    <bpmn:startEvent id="MIF_Start">
      <bpmn:outgoing>MIF_ToClean</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="MIF_ToClean" sourceRef="MIF_Start" targetRef="MIF_Clean" />
    <bpmn:subProcess id="MIF_Clean">
      <bpmn:incoming>MIF_ToClean</bpmn:incoming>
      <bpmn:outgoing>MIF_ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[&#34;c1&#34;,&#34;c2&#34;]" inputElement="group" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="MIF_CleanStart">
        <bpmn:outgoing>MIF_CleanToCall</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="MIF_CleanToCall" sourceRef="MIF_CleanStart" targetRef="MIF_CallClean" />
      <bpmn:callActivity id="MIF_CallClean">
        <bpmn:extensionElements>
          <zeebe:calledElement processId="=whichProcess" />
          <zeebe:ioMapping>
            <zeebe:input source="=&#34;clean&#34;" target="whichCase" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>MIF_CleanToCall</bpmn:incoming>
        <bpmn:outgoing>MIF_CleanToEnd</bpmn:outgoing>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true">
          <bpmn:extensionElements>
            <zeebe:loopCharacteristics inputCollection="=[&#34;p1&#34;,&#34;p2&#34;]" inputElement="position" />
          </bpmn:extensionElements>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:callActivity>
      <bpmn:sequenceFlow id="MIF_CleanToEnd" sourceRef="MIF_CallClean" targetRef="MIF_CleanEnd" />
      <bpmn:endEvent id="MIF_CleanEnd">
        <bpmn:incoming>MIF_CleanToEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="MIF_ToEnd" sourceRef="MIF_Clean" targetRef="MIF_End" />
    <bpmn:endEvent id="MIF_End">
      <bpmn:incoming>MIF_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
