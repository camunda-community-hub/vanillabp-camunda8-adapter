<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- The root level alone does the work here. It used to hold org.testcontainers, tc
         and com.github.dockerjava at WARN, which also kept them out of the replay of a
         FAILING class: a record dropped by its level reaches no appender, so there is
         nothing left to print afterwards. What INFO costs in a green build is the handful
         of lines from before the first extension callback - Docker detection runs in an
         ExecutionCondition ('@Testcontainers(disabledWithoutDocker = true)'), and the
         image pull and the Ryuk reaper start with it - and no extension reaches those. -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
