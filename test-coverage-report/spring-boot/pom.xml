<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.camunda.community.vanillabp</groupId>
    <artifactId>camunda8-adapter-test-coverage-report</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>camunda8-adapter-spring-boot-report</artifactId>
  <packaging>pom</packaging>
  <name>VanillaBP Camunda 8 adapter - Test coverage report - Spring Boot</name>
  <description>Aggregated test coverage of the Camunda 8 adapter's platform-neutral core and its Spring Boot integration.</description>

  <dependencies>
    <dependency>
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-spring-boot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- the shared-cluster election lives in a module of its own, because a
         workflow module is a classpath entry and that test is a workflow module of its
         own. Its execution data belongs to this report like every other
         Spring Boot test's -->
    <dependency>
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-election-integration-test</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.camunda.community.vanillabp</groupId>
      <artifactId>camunda8-adapter-smoke-test</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-deploy-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <!-- nothing to deploy - report is published on Github pages -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <goals>
              <!-- 'report-aggregate' sums up all '*.exec' files found in the modules listed in <dependencies> into one report -->
              <goal>report-aggregate</goal>
            </goals>
            <phase>verify</phase>
            <configuration>
              <outputDirectory>${project.basedir}/report</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
