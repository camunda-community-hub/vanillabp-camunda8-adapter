<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_AggregateChanged"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="AggregateChangedProcess" isExecutable="true">
    <bpmn:startEvent id="AC_Start">
      <bpmn:outgoing>AC_ToWait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="AC_ToWait" sourceRef="AC_Start" targetRef="AC_Wait" />
    <bpmn:serviceTask id="AC_Wait">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="awaitPush" />
      </bpmn:extensionElements>
      <bpmn:incoming>AC_ToWait</bpmn:incoming>
      <bpmn:outgoing>AC_ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="AC_ToEnd" sourceRef="AC_Wait" targetRef="AC_End" />
    <bpmn:endEvent id="AC_End">
      <bpmn:incoming>AC_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="AggregateChangedMultiInstanceProcess" isExecutable="true">
    <bpmn:startEvent id="MI_Start">
      <bpmn:outgoing>MI_ToSub</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="MI_ToSub" sourceRef="MI_Start" targetRef="MI_Sub" />
    <bpmn:subProcess id="MI_Sub">
      <bpmn:incoming>MI_ToSub</bpmn:incoming>
      <bpmn:outgoing>MI_ToEnd</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=[1,2]" inputElement="item" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="MI_SubStart">
        <bpmn:outgoing>MI_SubToTask</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sequenceFlow id="MI_SubToTask" sourceRef="MI_SubStart" targetRef="MI_Task" />
      <bpmn:serviceTask id="MI_Task">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="awaitPushPerInstance" />
        </bpmn:extensionElements>
        <bpmn:incoming>MI_SubToTask</bpmn:incoming>
        <bpmn:outgoing>MI_TaskToEnd</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="MI_TaskToEnd" sourceRef="MI_Task" targetRef="MI_SubEnd" />
      <bpmn:endEvent id="MI_SubEnd">
        <bpmn:incoming>MI_TaskToEnd</bpmn:incoming>
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="MI_ToEnd" sourceRef="MI_Sub" targetRef="MI_End" />
    <bpmn:endEvent id="MI_End">
      <bpmn:incoming>MI_ToEnd</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
